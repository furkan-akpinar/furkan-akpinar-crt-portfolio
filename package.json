{
  "name": "furkan-akpinar-crt-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Furkan Akpınar's interactive portfolio with WebGPU, a cinematic CRT interface and a continuous 3D project film.",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "node scripts/prepare-computer.mjs && node scripts/prepare-mobile-computer.mjs --verify && next build && node scripts/package-static.mjs",
    "start": "wrangler dev --port 3256",
    "preview": "wrangler dev --port 3256",
    "deploy": "npm run build && wrangler deploy",
    "check": "npm run typecheck && npm run lint && npm test",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "author": "Furkan Akpınar",
  "repository": {
    "type": "git",
    "url": "https://github.com/furkan-akpinar/furkan-akpinar-crt-portfolio.git"
  },
  "homepage": "https://furkanakpinar.dev/",
  "overrides": {
    "sharp": "0.35.5"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "@react-three/fiber": "9.8.1",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "typescript": "6.0.3",
    "wrangler": "4.147.0"
  }
}
