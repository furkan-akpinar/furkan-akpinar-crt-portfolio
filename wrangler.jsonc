{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "furkan-akpinar-crt-portfolio",
  "main": "worker/asset-worker.ts",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/assets/*/models/furkan-crt/furkan-crt-computer.glb",
      "/models/furkan-crt/furkan-crt-computer.glb",
      "/assets/*/media/hero-pinterest/showreel.mp4",
      "/media/hero-pinterest/showreel.mp4"
    ],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "workers_dev": true,
  "preview_urls": true,
  "send_metrics": false,
  "routes": [
    {
      "pattern": "furkanakpinar.dev",
      "custom_domain": true
    }
  ]
}
