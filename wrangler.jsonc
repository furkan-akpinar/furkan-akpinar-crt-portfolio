{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "furkan-akpinar-crt-portfolio",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "workers_dev": true,
  "preview_urls": true,
  "send_metrics": false
}
